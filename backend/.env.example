# Copy to .env for local development. Never commit real secrets.
APP_ENV=development
APP_NAME=Dual-Path Validation Platform API
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://app_user:change_me@localhost:5432/dualpath
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=["http://localhost:3000"]
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_USERNAME=platform-admin
INITIAL_ADMIN_PASSWORD=replace-this-before-first-run
UPLOAD_ROOT=./var/uploads
MAX_UPLOAD_MB=100
